<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quality Inspection Form</title>
  <!-- Include Papaparse for CSV parsing -->
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.3.2/papaparse.min.js"></script>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fb;
      color: #1f2937;
    }
    .page {
      max-width: 1300px;
      margin: 30px auto;
      padding: 20px;
    }
    h1 {
      text-align: center;
      color: #0b376d;
      margin-bottom: 25px;
      font-size: 34px;
    }
    .form-card {
      background: #ffffff;
      border-radius: 12px;
      padding: 22px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
      border: 1px solid #d7e0eb;
    }
    .top-fields {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 25px;
    }
    .field label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
      font-size: 14px;
    }
    .field input,
    .field select {
      width: 100%;
      box-sizing: border-box;
      padding: 11px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 15px;
      background: white;
    }
    .table-wrapper {
      overflow-x: auto;
      border-radius: 10px;
      border: 1px solid #cbd5e1;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 950px;
    }
    thead {
      background: #0b4f93;
      color: white;
    }
    th,
    td {
      padding: 14px;
      border: 1px solid #d8e1ec;
      vertical-align: middle;
      font-size: 15px;
    }
    th {
      text-align: center;
      font-size: 15px;
    }
    tbody tr:nth-child(even) {
      background: #f8fbff;
    }
    .item-col {
      text-align: center;
      font-weight: bold;
      width: 80px;
    }
    .check-col {
      min-width: 400px;
    }
    .judge-col {
      min-width: 280px;
      text-align: center;
    }
    .actual-col {
      min-width: 180px;
      text-align: center;
    }
    .radio-group {
      display: flex;
      justify-content: center;
      gap: 20px;
      align-items: center;
    }
    .radio-group label {
      font-weight: bold;
      cursor: pointer;
    }
    .actual-input {
      width: 90%;
      padding: 9px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 15px;
    }
    .ok-box {
      background: #e6f7ec;
      color: #0f6b35;
      border: 1px solid #b7ebc6;
      font-weight: bold;
      border-radius: 6px;
      padding: 9px;
      display: inline-block;
      min-width: 90px;
    }
    .ng-box {
      background: #fdeaea;
      color: #b42318;
      border: 1px solid #f3b8b8;
      font-weight: bold;
      border-radius: 6px;
      padding: 9px;
      display: inline-block;
      min-width: 90px;
    }
    .write-actual-label {
      color: #0b4f93;
      font-weight: bold;
    }
    .buttons {
      display: flex;
      justify-content: center;
      gap: 25px;
      margin-top: 25px;
      flex-wrap: wrap;
    }
    button {
      padding: 13px 35px;
      border-radius: 8px;
      border: none;
      font-size: 16px;
      cursor: pointer;
      font-weight: bold;
    }
    .save-btn {
      background: white;
      color: #0b4f93;
      border: 1px solid #0b4f93;
    }
    .submit-btn {
      background: #0b63ce;
      color: white;
    }
    .clear-btn {
      background: white;
      color: #333;
      border: 1px solid #9ca3af;
    }
    .loading {
      text-align: center;
      padding: 20px;
      font-weight: bold;
      color: #0b4f93;
    }
    @media (max-width: 900px) {
      .top-fields {
        grid-template-columns: repeat(2, 1fr);
      }
      h1 {
        font-size: 28px;
      }
    }
    @media (max-width: 600px) {
      .top-fields {
        grid-template-columns: 1fr;
      }
      .page {
        margin: 10px auto;
        padding: 10px;
      }
      h1 {
        font-size: 24px;
      }
      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <h1>Quality Inspection Form</h1>
    <div class="form-card">
      <div class="top-fields">
        <div class="field">
          <label>Inspection Date</label>
          <input type="date" id="inspectionDate" />
        </div>
        <div class="field">
          <label>Inspector</label>
          <input type="text" id="inspector" placeholder="Enter inspector name" />
        </div>
        <div class="field">
          <label>Part Number</label>
          <!-- Dropdown for part numbers populated dynamically -->
          <select id="partNumberDropdown">
            <option value="">Select Part Number</option>
          </select>
        </div>
        <div class="field">
          <label>Line</label>
          <select id="line">
            <option value="">Select Line</option>
            <option>Line 1</option>
            <option>Line 2</option>
            <option>Line 3</option>
            <option>Line 4</option>
          </select>
        </div>
        <div class="field">
          <label>Shift</label>
          <select id="shift">
            <option value="">Select Shift</option>
            <option>1st Shift</option>
            <option>2nd Shift</option>
            <option>3rd Shift</option>
          </select>
        </div>
        <div class="field">
          <label>Lot Number</label>
          <input type="text" id="lotNumber" placeholder="Enter lot number" />
        </div>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Item #</th>
              <th>Check Item / Check Method / Criteria</th>
              <th>Type of Judgement (OK / NG / Write Actual)</th>
              <th>Actual</th>
            </tr>
          </thead>
          <tbody id="inspectionTableBody">
            <tr>
              <td colspan="4" class="loading">
                Loading inspection items from Google Sheets...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="buttons">
        <button class="save-btn" onclick="saveDraft()">Save Draft</button>
        <button class="submit-btn" onclick="submitInspection()">Submit Inspection</button>
        <button class="clear-btn" onclick="clearForm()">Clear</button>
      </div>
    </div>
  </div>
  <script>
    // Replace with your published Google Sheets CSV link
    const GOOGLE_SHEET_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQ7irOB1dkEiMMVkf8rEOgcfKYauZVTv50D9GfRvzio3447qzzYKKMYu2WqQVH4QvB5Zw8knwoIVU21/pub?gid=0&single=true&output=csv";

    let inspectionData = [];

    document.addEventListener("DOMContentLoaded", function () {
      setTodayDate();
      loadInspectionData();
    });

    function setTodayDate() {
      const today = new Date().toISOString().split("T")[0];
      document.getElementById("inspectionDate").value = today;
    }

    function loadInspectionData() {
      // Use PapaParse to download and parse the CSV data
      Papa.parse(GOOGLE_SHEET_CSV_URL, {
        download: true,
        header: true,
        complete: function (results) {
          // Filter out any empty rows
          inspectionData = results.data.filter(
            (row) => row.part_number && row.item_no
          );
          buildPartNumberDropdown(inspectionData);
        },
        error: function (error) {
          console.error("Error loading Google Sheet data:", error);
          document.getElementById("inspectionTableBody").innerHTML = `
            <tr>
              <td colspan="4" class="loading">
                Could not load inspection items. Please check your Google Sheet CSV link.
              </td>
            </tr>
          `;
        },
      });
    }

    function buildPartNumberDropdown(data) {
      const dropdown = document.getElementById("partNumberDropdown");
      // Clear existing options except placeholder
      dropdown.innerHTML = `<option value="">Select Part Number</option>`;
      // Get unique part numbers
      const partNumbers = [...new Set(data.map((item) => item.part_number))];
      partNumbers.forEach((pn) => {
        const option = document.createElement("option");
        option.value = pn;
        option.textContent = pn;
        dropdown.appendChild(option);
      });
      // Add change event
      dropdown.addEventListener("change", function () {
        const selected = this.value;
        updateInspectionTable(selected);
      });
      // Optionally select the first part number automatically
      if (partNumbers.length > 0) {
        dropdown.value = partNumbers[0];
        updateInspectionTable(partNumbers[0]);
      }
    }

    function updateInspectionTable(partNumber) {
      const tbody = document.getElementById("inspectionTableBody");
      tbody.innerHTML = "";
      if (!partNumber) {
        tbody.innerHTML = `
          <tr><td colspan="4" class="loading">Please select a part number.</td></tr>
        `;
        return;
      }
      const items = inspectionData.filter(
        (item) => item.part_number === partNumber
      );
      items.forEach((item, index) => {
        const row = document.createElement("tr");
        const itemNo = item.item_no || index + 1;
        const combinedText = `${item.check_item || ""} / ${item.check_method || ""} / ${item.criteria || ""}`;
        let judgementHtml = "";
        let actualHtml = "";
        const uniqueName = `judgement_${partNumber}_${index}`;
        if (item.judgement_type && item.judgement_type.toUpperCase() === "OK_NG") {
          judgementHtml = `
            <div class="radio-group">
              <label>
                <input type="radio" name="${uniqueName}" value="OK" onchange="updateActualDisplay('${uniqueName}', 'OK')">
                OK
              </label>
              <label>
                <input type="radio" name="${uniqueName}" value="NG" onchange="updateActualDisplay('${uniqueName}', 'NG')">
                NG
              </label>
            </div>
          `;
          actualHtml = `<span id="${uniqueName}_display">-</span>`;
        } else {
          judgementHtml = `<span class="write-actual-label">Write Actual</span>`;
          actualHtml = `<input type="text" class="actual-input" id="${uniqueName}_actual" placeholder="Enter actual value">`;
        }
        row.innerHTML = `
          <td class="item-col">${itemNo}</td>
          <td class="check-col">${combinedText}</td>
          <td class="judge-col">${judgementHtml}</td>
          <td class="actual-col">${actualHtml}</td>
        `;
        tbody.appendChild(row);
      });
    }

    function updateActualDisplay(name, value) {
      const displaySpan = document.getElementById(`${name}_display`);
      if (displaySpan) {
        if (value === "OK") {
          displaySpan.innerHTML = `<span class="ok-box">OK</span>`;
        } else if (value === "NG") {
          displaySpan.innerHTML = `<span class="ng-box">NG</span>`;
        }
      }
    }

    function collectInspectionData() {
      const headerData = {
        inspectionDate: document.getElementById("inspectionDate").value,
        inspector: document.getElementById("inspector").value,
        partNumber: document.getElementById("partNumberDropdown").value,
        line: document.getElementById("line").value,
        shift: document.getElementById("shift").value,
        lotNumber: document.getElementById("lotNumber").value,
      };
      const partNumber = headerData.partNumber;
      const items = inspectionData.filter(
        (item) => item.part_number === partNumber
      );
      const results = items.map((item, index) => {
        const uniqueName = `judgement_${partNumber}_${index}`;
        let judgement = "";
        let actual = "";
        if (item.judgement_type && item.judgement_type.toUpperCase() === "OK_NG") {
          const selected = document.querySelector(
            `input[name="${uniqueName}"]:checked`
          );
          judgement = selected ? selected.value : "";
          actual = judgement;
        } else {
          const actualInput = document.getElementById(`${uniqueName}_actual`);
          actual = actualInput ? actualInput.value : "";
          judgement = "ACTUAL";
        }
        return {
          part_number: partNumber,
          item_no: item.item_no,
          check_item: item.check_item,
          check_method: item.check_method,
          criteria: item.criteria,
          judgement_type: item.judgement_type,
          judgement: judgement,
          actual: actual,
        };
      });
      return {
        header: headerData,
        results: results,
      };
    }

    function saveDraft() {
      const data = collectInspectionData();
      localStorage.setItem("inspectionDraft", JSON.stringify(data));
      alert("Draft saved on this device.");
    }

    function submitInspection() {
      const data = collectInspectionData();
      console.log("Inspection submitted:", data);
      alert(
        "Inspection data collected. Next step is saving this result back to Google Sheets or another database."
      );
    }

    function clearForm() {
      if (!confirm("Are you sure you want to clear the form?")) {
        return;
      }
      document.getElementById("inspectionDate").value = new Date()
        .toISOString()
        .split("T")[0];
      document.getElementById("inspector").value = "";
      document.getElementById("line").value = "";
      document.getElementById("shift").value = "";
      document.getElementById("lotNumber").value = "";
      // reset dropdown to placeholder
      const dropdown = document.getElementById("partNumberDropdown");
      dropdown.value = "";
      document.getElementById("inspectionTableBody").innerHTML = `
        <tr><td colspan="4" class="loading">Please select a part number.</td></tr>
      `;
    }
  </script>
</body>
</html>
